# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 .gitignore 에 있어 커밋되지 않음)

# OpenWeatherMap - 브라우저에서 직접 호출하므로 VITE_ 접두사가 필요하다.
# VITE_ 접두사가 붙은 값은 빌드 결과물(번들)에 포함된다(무료 등급에서 감수).
# https://openweathermap.org/ 가입 후 My API Keys 에서 발급
VITE_OPENWEATHER_API_KEY=

# Last.fm - 서버(개발 프록시 / 배포용 서버리스 함수)에서만 사용한다.
# VITE_ 접두사가 없으므로 클라이언트 번들에 들어가지 않는다.
# 배포 시에는 호스팅 플랫폼의 "서버 환경변수"로 등록한다.
# https://www.last.fm/api/account/create 에서 발급
LASTFM_API_KEY=
